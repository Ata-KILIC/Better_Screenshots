<Window x:Class="BetterScreenshots.Editor.AnnotationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit screenshot — Better Screenshots" Width="1120" Height="760" MinWidth="720" MinHeight="500" Background="#F7F7F8">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="10">
      <WrapPanel VerticalAlignment="Center">
        <Button Content="Arrow" Tag="Arrow" Click="ToolClick" Margin="0,0,5,0"/><Button Content="Rectangle" Tag="Rectangle" Click="ToolClick" Margin="0,0,5,0"/><Button Content="Ellipse" Tag="Ellipse" Click="ToolClick" Margin="0,0,5,0"/><Button Content="Line" Tag="Line" Click="ToolClick" Margin="0,0,5,0"/><Button Content="Pen" Tag="Pen" Click="ToolClick" Margin="0,0,5,0"/><Button Content="Highlight" Tag="Highlighter" Click="ToolClick" Margin="0,0,5,0"/><Button Content="Text" Tag="Text" Click="ToolClick" Margin="0,0,5,0"/><Button Content="#" Tag="Number" Click="ToolClick" Margin="0,0,12,0"/>
        <Button Content="Crop" Tag="Crop" Click="ToolClick" Margin="0,0,5,0"/><Button Content="Blur" Tag="Blur" Click="ToolClick" Margin="0,0,5,0"/><Button Content="Pixelate" Tag="Pixelate" Click="ToolClick" Margin="0,0,5,0"/><Button Content="Redact" Tag="Redact" Click="ToolClick" Margin="0,0,12,0"/>
        <TextBlock Text="Color" VerticalAlignment="Center" Margin="0,0,4,0"/><ComboBox x:Name="ColorBox" Width="88" SelectedIndex="0" SelectionChanged="ColorChanged" Margin="0,0,10,0"><ComboBoxItem Content="Red"/><ComboBoxItem Content="Blue"/><ComboBoxItem Content="Black"/><ComboBoxItem Content="Yellow"/><ComboBoxItem Content="Green"/></ComboBox>
        <TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,4,0"/><Slider x:Name="Thickness" Width="72" Minimum="1" Maximum="18" Value="3" TickFrequency="1" IsSnapToTickEnabled="True"/>
        <Button Content="Undo" Click="UndoClick" Margin="16,0,5,0"/><Button Content="Redo" Click="RedoClick" Margin="0,0,5,0"/>
        <Button Content="Save" Click="SaveClick" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Margin="16,0,5,0"/><Button Content="Cancel" Click="CancelClick"/>
      </WrapPanel>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D1D5DB" Padding="18">
      <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
        <Image x:Name="BaseImage" Stretch="None" SnapsToDevicePixels="True"/>
        <Canvas x:Name="DrawingCanvas" Background="Transparent" MouseLeftButtonDown="CanvasMouseDown" MouseMove="CanvasMouseMove" MouseLeftButtonUp="CanvasMouseUp"/>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
