<Window x:Class="BetterScreenshots.Capture.RegionCaptureOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" Focusable="True">
  <Grid x:Name="Root" Cursor="Cross" PreviewMouseLeftButtonDown="OnMouseDown" PreviewMouseMove="OnMouseMove" PreviewMouseLeftButtonUp="OnMouseUp" PreviewKeyDown="OnKeyDown">
    <Image x:Name="SnapshotImage" Stretch="Fill" SnapsToDevicePixels="True" />
    <Canvas x:Name="OverlayCanvas">
      <Rectangle x:Name="ShadeTop" Fill="#99000000" />
      <Rectangle x:Name="ShadeLeft" Fill="#99000000" />
      <Rectangle x:Name="ShadeRight" Fill="#99000000" />
      <Rectangle x:Name="ShadeBottom" Fill="#99000000" />
      <Border x:Name="SelectionBorder" BorderBrush="#4DA3FF" BorderThickness="2" Visibility="Collapsed" />
      <TextBlock x:Name="Dimensions" Background="#E61F2937" Foreground="White" Padding="6,3" FontSize="12" Visibility="Collapsed" />
      <Border x:Name="Magnifier" Width="126" Height="126" BorderBrush="White" BorderThickness="2" Background="#111827" Visibility="Collapsed" ClipToBounds="True">
        <Image x:Name="MagnifierImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
      </Border>
    </Canvas>
  </Grid>
</Window>
