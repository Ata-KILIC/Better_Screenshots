<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <UseSystemDrawing>true</UseSystemDrawing>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon />
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <WindowsSdkPackageVersion>10.0.19041.54</WindowsSdkPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\App.xaml.cs" Link="App.xaml.cs" />
    <Compile Include="..\..\AppController.cs" Link="AppController.cs" />
    <Compile Include="..\..\MainWindow.xaml.cs" Link="MainWindow.xaml.cs" />
  </ItemGroup>
</Project>
