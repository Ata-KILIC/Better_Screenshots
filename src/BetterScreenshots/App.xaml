<Application x:Class="BetterScreenshots.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBrush" Color="#FAFAFC" />
    <SolidColorBrush x:Key="CardBrush" Color="White" />
    <SolidColorBrush x:Key="InkBrush" Color="#202124" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="11,6" /><Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="#F3F4F6" /><Setter Property="BorderBrush" Value="#E5E7EB" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,5" /><Setter Property="BorderBrush" Value="#D1D5DB" /><Setter Property="BorderThickness" Value="1" /></Style>
  </Application.Resources>
</Application>
